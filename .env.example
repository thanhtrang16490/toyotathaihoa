# Runtime environment variables for the Node server
SITE_INDEXABLE=false
# Supabase Data API. Keep the secret key on the Node server.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Alternative when neither Supabase variable is set.
# HTTPS endpoint must respond with HTTP 2xx and {"accepted":true}
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Exact HTTPS origin for a separate staging hostname
PREVIEW_ORIGIN=
